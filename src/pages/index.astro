import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Technologies from '../components/Technologies.astro';
import ProjectsPreview from '../components/ProjectsPreview.astro';
import Experience from '../components/Experience.astro';
import Contact from '../components/Contact.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Huzaifa Alfahl',
  jobTitle: 'Full Stack Engineer',
  email: 'mailto:huzaifa963sy@gmail.com',
  url: 'https://huzaifa-0.github.io',
  sameAs: ['https://github.com/Huzaifa-0', 'https://www.linkedin.com/in/huzayfa-alfahl-7878961b9/'],
