---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <div class="min-h-[70vh] flex items-center justify-center">
    <div class="text-center">
      <h1 class="text-4xl font-bold mb-4">404</h1>
      <p class="text-xl text-muted-foreground mb-4">Oops! Page not found</p>
      <a href="/" class="text-primary hover:underline underline-offset-4">Return to Home</a>
    </div>
  </div>
</BaseLayout>
