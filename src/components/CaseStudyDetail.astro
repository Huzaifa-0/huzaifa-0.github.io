---
import type { CollectionEntry } from 'astro:content';
import CaseSection from './CaseSection.astro';
import FlowChart from './FlowChart.astro';

interface Props {
  study: CollectionEntry<'caseStudies'>['data'];
}

const { study } = Astro.props;
const { architecture: arch } = study;

// Template placeholders such as "<add GitHub URL>" are skipped until replaced.
const isUrl = (v?: string | null): v is string => !!v && v.startsWith('http');
const links = [
  { label: 'View Repository', href: study.links.repository },
  { label: 'Live Demo', href: study.links.liveDemo },
].filter((l) => isUrl(l.href));

const label = (key: string) => key.replace(/([A-Z])/g, ' $1');
const metrics = study.metrics?.items.filter((m) => m.value);
const bullet = 'inline-block w-2 h-2 rounded-full bg-primary mt-2 flex-shrink-0';
const panel = 'bg-secondary/30 p-6 rounded-lg border border-border/40';
---

<div class="pb-20">
  <div class="container max-w-5xl mx-auto">
    <div data-reveal data-reveal-delay="0.1" class="mb-8">
      <a href="/case-studies" class="group inline-flex items-center gap-2 mb-4 text-sm font-medium hover:bg-accent hover:text-accent-foreground rounded-md px-4 py-2 -ml-4 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:-translate-x-1"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        Back to Case Studies
      </a>
    </div>

    <header data-reveal data-reveal-delay="0.2" class="mb-12">
      <div class="mb-4 flex flex-wrap gap-2">
        {study.type && <span class="text-xs bg-secondary px-3 py-1 rounded-full">{study.type}</span>}
        {study.status && <span class="text-xs border border-border px-3 py-1 rounded-full">{study.status}</span>}
      </div>
      <h1 class="text-3xl md:text-4xl font-bold mb-4">{study.title}</h1>
      <p class="text-xl text-muted-foreground mb-6">{study.tagline}</p>
      <p class="text-sm text-muted-foreground mb-6"><span class="font-semibold text-foreground">Role:</span> {study.role}</p>
      <div class="flex flex-wrap gap-3">
        {links.map((l) => (
          <a href={l.href!} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-6 transition-colors">{l.label}</a>
        ))}
        {study.relatedProjectId && (
          <a href={`/projects/${study.relatedProjectId}`} class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-secondary text-secondary-foreground hover:bg-secondary/80 h-10 px-6 transition-colors">Related Project</a>
        )}
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-14">
      <div data-reveal class="lg:col-span-2">
        <h2 class="text-2xl md:text-3xl font-bold mb-4">Overview</h2>
        <p class="text-lg leading-relaxed">{study.summary}</p>
      </div>
      <div data-reveal class={panel}>
        <h3 class="text-lg font-semibold mb-4">Tech Stack</h3>
        <div class="space-y-4">
          {Object.entries(study.techStack).map(([group, items]) => (
            <div>
              <p class="mb-2 text-xs font-medium uppercase tracking-wide text-muted-foreground">{label(group)}</p>
              <div class="flex flex-wrap gap-2">
                {items.map((t) => <span class="bg-secondary px-3 py-1 rounded-full text-sm">{t}</span>)}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    {metrics && metrics.length > 0 && (
      <CaseSection title="Key Numbers">
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {metrics.map((m) => (
            <div class={`${panel} text-center`}>
              <p class="text-2xl font-bold text-primary">{m.value}</p>
              <p class="mt-1 text-sm text-muted-foreground">{m.label}</p>
            </div>
          ))}
        </div>
      </CaseSection>
    )}

    <CaseSection title="The Problem">
      <p class="text-lg leading-relaxed mb-6">{study.problem.context}</p>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {study.problem.challenges.map((c) => (
          <li class="flex items-start gap-3"><span class={bullet}></span><span class="leading-relaxed">{c}</span></li>
        ))}
      </ul>
    </CaseSection>

    <CaseSection title="The Solution">
      <ol class="mb-8 space-y-3">
        {study.solution.approach.map((a, i) => (
          <li class="flex items-start gap-3">
            <span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-primary text-xs font-semibold text-primary-foreground">{i + 1}</span>
            <span class="leading-relaxed">{a}</span>
          </li>
        ))}
      </ol>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {study.solution.features.map((f) => (
          <div class={panel}>
            <h3 class="font-semibold mb-2">{f.name}</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">{f.description}</p>
          </div>
        ))}
      </div>
    </CaseSection>

    <CaseSection title="Architecture" id="architecture">
      <p class="text-lg mb-6">{arch.style}</p>

      {arch.flows && arch.flows.length > 0 && (
        <div class:list={['mb-8 grid grid-cols-1 gap-6', arch.flows.length > 1 && 'lg:grid-cols-2']}>
          {arch.flows.map((flow) => <FlowChart name={flow.name} steps={flow.steps} />)}
        </div>
      )}

      <h3 class="text-xl font-semibold mb-4">Components</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
        {arch.layers.map((layer) => (
          <div class={panel}>
            <div class="mb-2 flex flex-wrap items-center gap-2">
              <h4 class="font-semibold">{layer.name}</h4>
              {layer.tech && <span class="text-xs bg-secondary px-2 py-1 rounded-full">{layer.tech}</span>}
            </div>
            <p class="text-sm text-muted-foreground leading-relaxed">{layer.detail}</p>
          </div>
        ))}
      </div>

      {arch.keyBoundaries && (
        <ul class="mb-6 space-y-3">
          {arch.keyBoundaries.map((b) => (
            <li class="flex items-start gap-3"><span class={bullet}></span><span class="leading-relaxed">{b}</span></li>
          ))}
        </ul>
      )}

      {(arch.queues || arch.scheduledMaintenance) && (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {arch.queues && (
            <div class={panel}>
              <h4 class="font-semibold mb-3">Queues</h4>
              <div class="flex flex-wrap gap-2">{arch.queues.map((q) => <span class="bg-secondary px-3 py-1 rounded-full text-sm">{q}</span>)}</div>
            </div>
          )}
          {arch.scheduledMaintenance && (
            <div class={panel}>
              <h4 class="font-semibold mb-3">Scheduled Maintenance</h4>
              <ul class="space-y-2 text-sm">
                {arch.scheduledMaintenance.map((m) => <li class="flex items-start gap-3"><span class={bullet}></span><span>{m}</span></li>)}
              </ul>
            </div>
          )}
        </div>
      )}
    </CaseSection>

    {study.guardrailLogic && (
      <CaseSection title="Guardrail Logic">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {Object.entries(study.guardrailLogic).map(([k, v]) => (
            <div class={panel}>
              <p class="mb-2 text-xs font-medium uppercase tracking-wide text-muted-foreground">{label(k)}</p>
              <p class="text-sm leading-relaxed">{v}</p>
            </div>
          ))}
        </div>
      </CaseSection>
    )}

    {study.apiSurface && (
      <CaseSection title="API Surface">
        <div class="overflow-x-auto rounded-lg border border-border/40">
          <table class="w-full text-left text-sm">
            <tbody>
              {study.apiSurface.map((e) => (
                <tr class="border-b border-border/40 last:border-0">
                  <td class="px-4 py-3 font-mono text-xs font-semibold">{e.method}</td>
                  <td class="px-4 py-3 font-mono text-xs whitespace-nowrap">{e.path}</td>
                  <td class="px-4 py-3 text-muted-foreground">{e.purpose}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </CaseSection>
    )}

    {study.demo && (
      <CaseSection title="Demo Workflow">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <FlowChart name={`Primary user: ${study.demo.primaryUser}`} steps={study.demo.workflow} />
          <div class={panel}>
            <h3 class="font-semibold mb-1">Demo data</h3>
            <p class="mb-3 text-sm text-muted-foreground">{study.demo.data.note} Student {study.demo.data.student}.</p>
            <ul class="mb-4 space-y-2 text-sm">
              {study.demo.data.records.map((r) => <li class="flex items-start gap-3"><span class={bullet}></span><span>{r}</span></li>)}
            </ul>
            <p class="text-sm"><span class="font-semibold">Expected:</span> {study.demo.data.expectedOutput}</p>
          </div>
        </div>
      </CaseSection>
    )}

    {study.keyDecisions && (
      <CaseSection title="Key Decisions">
        <div class="space-y-4">
          {study.keyDecisions.map((d) => (
            <div class={panel}>
              <h3 class="font-semibold mb-2">{d.decision}</h3>
              <p class="text-sm leading-relaxed"><span class="font-medium">Why:</span> <span class="text-muted-foreground">{d.reason}</span></p>
              {d.tradeoff && <p class="mt-1 text-sm leading-relaxed"><span class="font-medium">Trade-off:</span> <span class="text-muted-foreground">{d.tradeoff}</span></p>}
            </div>
          ))}
        </div>
      </CaseSection>
    )}

    {study.challenges && (
      <CaseSection title="Technical Challenges">
        <div class="space-y-4">
          {study.challenges.map((c) => (
            <div class={panel}>
              <h3 class="font-semibold mb-2">{c.challenge}</h3>
              <p class="text-sm leading-relaxed"><span class="font-medium">Solution:</span> <span class="text-muted-foreground">{c.solution}</span></p>
              {c.outcome && <p class="mt-1 text-sm leading-relaxed"><span class="font-medium">Outcome:</span> <span class="text-muted-foreground">{c.outcome}</span></p>}
            </div>
          ))}
        </div>
      </CaseSection>
    )}

    {study.lessons && (
      <CaseSection title="Challenges & Lessons">
        <div class="space-y-4">
          {study.lessons.map((l) => (
            <div class={panel}>
              <h3 class="font-semibold mb-2">{l.challenge}</h3>
              <p class="text-sm leading-relaxed text-muted-foreground">{l.lesson}</p>
            </div>
          ))}
        </div>
      </CaseSection>
    )}

    {study.outcomes && (
      <CaseSection title="Outcomes">
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {study.outcomes.map((o) => <li class="flex items-start gap-3"><span class={bullet}></span><span class="leading-relaxed">{o}</span></li>)}
        </ul>
      </CaseSection>
    )}

    <CaseSection title="Engineering Practices">
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {study.engineering.map((e) => <li class="flex items-start gap-3"><span class={bullet}></span><span class="leading-relaxed">{e}</span></li>)}
      </ul>
    </CaseSection>

    {(study.limitations || study.nextSteps) && (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {study.limitations && (
          <div data-reveal class={panel}>
            <h2 class="text-xl font-semibold mb-4 text-primary">Known Limitations</h2>
            <ul class="space-y-3 text-sm">
              {study.limitations.map((l) => <li class="flex items-start gap-3"><span class={bullet}></span><span class="leading-relaxed">{l}</span></li>)}
            </ul>
          </div>
        )}
        {study.nextSteps && (
          <div data-reveal class={panel}>
            <h2 class="text-xl font-semibold mb-4 text-primary">Next Steps</h2>
            <ul class="space-y-3 text-sm">
              {study.nextSteps.map((n) => <li class="flex items-start gap-3"><span class={bullet}></span><span class="leading-relaxed">{n}</span></li>)}
            </ul>
          </div>
        )}
      </div>
    )}
  </div>
</div>
