---
const navigationItems = [
  { label: 'Home', path: '/' },
  { label: 'Experience', path: '/#experience' },
  { label: 'Projects', path: '/projects' },
  { label: 'Case Studies', path: '/case-studies' },
  { label: 'Contact', path: '/#contact' },
];

const currentPath = Astro.url.pathname;
const isActivePath = (path: string) => path === currentPath || (path.startsWith('/') && !path.includes('#') && path !== '/' && currentPath.startsWith(path));
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 ease-out-expo w-full py-5">
  <div class="container flex items-center justify-between w-full">
    <a href="/" class="text-xl font-semibold transition-all duration-300 ease-out-expo hover:opacity-80">
      <span class="sr-only">Portfolio</span>
      <div class="flex items-center gap-2">
        <div class="w-3 h-3 bg-primary rounded-full"></div>
        <span>Portfolio</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-8">
      {navigationItems.map((item) => {
        const isActive = isActivePath(item.path);
        return (
          <a
            href={item.path}
            data-nav-link
            data-hash={item.path.startsWith('/#') ? item.path.slice(2) : undefined}
            class:list={[
              'text-sm font-medium transition-all hover:text-primary relative',
              'after:absolute after:bottom-0 after:left-0 after:right-0 after:h-0.5 after:origin-center',
              'after:scale-x-0 after:bg-primary after:transition-transform after:duration-300',
              'hover:after:scale-x-100',
              isActive ? 'text-primary after:scale-x-100' : '',
            ]}
          >
            {item.label}
          </a>
        );
      })}
      <a
        href="/resume/Huzaifa_Alfahl_Full_Stack_Engineer_Resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="relative inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50"
      >
        Resume
      </a>
    </nav>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="md:hidden z-[70] inline-flex items-center justify-center h-10 w-10 rounded-md hover:bg-accent hover:text-accent-foreground transition-colors"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <svg id="icon-menu" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>
</header>

<!-- Mobile Navigation -->
<div id="mobile-menu" class="md:hidden fixed inset-0 bg-background z-[60] transition-all duration-300 ease-out-expo opacity-0 invisible">
  <button
    id="mobile-menu-close"
    type="button"
    class="absolute top-5 right-4 z-[70] inline-flex items-center justify-center h-10 w-10 rounded-md hover:bg-accent hover:text-accent-foreground transition-colors"
    aria-label="Close menu"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
  </button>

  <div class="flex flex-col items-center justify-center h-full w-full space-y-8 px-4">
    {navigationItems.map((item) => {
      const isActive = isActivePath(item.path);
      return (
        <a
          href={item.path}
          data-nav-link
          data-hash={item.path.startsWith('/#') ? item.path.slice(2) : undefined}
          class:list={[
            'text-xl font-medium transition-all hover:text-primary',
            isActive ? 'text-primary' : '',
          ]}
        >
          {item.label}
        </a>
      );
    })}
    <a
      href="/resume/Huzaifa_Alfahl_Full_Stack_Engineer_Resume.pdf"
      target="_blank"
      rel="noopener noreferrer"
      class="relative inline-flex h-10 items-center justify-center rounded-md bg-primary px-8 py-2 text-base font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 mt-4"
    >
      Resume
    </a>
  </div>
</div>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('mobile-menu-toggle')!;
  const closeBtn = document.getElementById('mobile-menu-close')!;
  const menu = document.getElementById('mobile-menu')!;
  const iconMenu = document.getElementById('icon-menu')!;
  const iconClose = document.getElementById('icon-close')!;

  const onScroll = () => {
    const scrolled = window.scrollY > 10;
    header.classList.toggle('py-3', scrolled);
    header.classList.toggle('bg-white/80', scrolled);
    header.classList.toggle('dark:bg-background/80', scrolled);
    header.classList.toggle('backdrop-blur-md', scrolled);
    header.classList.toggle('shadow-sm', scrolled);
    header.classList.toggle('py-5', !scrolled);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  // scrollY forces layout; do the initial read in a frame instead of during script evaluation.
  requestAnimationFrame(onScroll);

  const setMenuOpen = (open: boolean) => {
    menu.classList.toggle('opacity-100', open);
    menu.classList.toggle('visible', open);
    menu.classList.toggle('opacity-0', !open);
    menu.classList.toggle('invisible', !open);
    iconMenu.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.style.overflow = open ? 'hidden' : 'unset';
  };

  toggle.addEventListener('click', () => setMenuOpen(!menu.classList.contains('opacity-100')));
  closeBtn.addEventListener('click', () => setMenuOpen(false));

  document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((link) => {
    link.addEventListener('click', (e) => {
      setMenuOpen(false);
      const hash = link.dataset.hash;
      if (hash && window.location.pathname === '/') {
        e.preventDefault();
        const el = document.getElementById(hash);
        if (el) {
          el.scrollIntoView({ behavior: 'smooth' });
          window.history.pushState(null, '', `#${hash}`);
        }
      }
    });
  });
</script>
