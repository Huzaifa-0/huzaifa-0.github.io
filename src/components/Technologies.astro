---
interface TechCategory {
  name: string;
  items: string[];
}

const techCategories: TechCategory[] = [
  { name: 'Backend', items: ['Nest.js', 'Express.js', 'Laravel', 'Core PHP', 'FastAPI'] },
  { name: 'Frontend', items: ['Vue.js', 'React.js', 'Next.js', 'jQuery UI', 'Tailwind CSS'] },
  { name: 'Databases', items: ['MongoDB', 'Redis', 'Memcached', 'MySQL', 'PostgreSQL'] },
  { name: 'DevOps', items: ['Git', 'GitHub Actions', 'CI/CD', 'Docker', 'Forge', 'PM2'] },
  { name: 'Cloud', items: ['AWS', 'DigitalOcean', 'GCP', 'Scaleway', 'Hetzner', 'Vercel'] },
  { name: 'AI/ML', items: ['ChatGPT', 'Claude', 'AI Agents', 'fast.ai', 'Hugging Face', 'Redis Vector Search', 'Collaborative Filtering', 'Content Moderation'] },
  { name: 'CMS', items: ['Strapi', 'Nova', 'Filament'] },
];
---

<section id="technologies" class="section bg-background">
  <div class="container">
    <div data-reveal data-reveal-delay="0.1" class="mb-4">
      <h2 class="section-title text-center">Technologies</h2>
    </div>

    <div data-reveal data-reveal-delay="0.2" class="mb-6">
      <div class="w-16 h-1 bg-primary mx-auto"></div>
    </div>

    <div data-reveal data-reveal-delay="0.3" class="mb-12">
      <p class="section-subtitle text-center mx-auto">
        The tools and technologies I use to bring ideas to life
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <div data-reveal data-reveal-delay="0.4" class="mb-8">
        <div role="tablist" class="grid grid-cols-2 md:grid-cols-5 w-full h-auto rounded-md bg-muted p-1 text-muted-foreground gap-1">
          {techCategories.map((category, index) => (
            <button
              type="button"
              role="tab"
              data-tab-trigger={category.name}
              aria-selected={index === 0 ? 'true' : 'false'}
              class:list={[
                'inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-3 text-sm font-medium transition-all',
                index === 0 ? 'bg-background text-primary shadow-sm' : '',
              ]}
            >
              {category.name}
            </button>
          ))}
        </div>
      </div>

      {techCategories.map((category, index) => (
        <div data-tab-panel={category.name} class:list={['mt-4', index === 0 ? '' : 'hidden']}>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
            {category.items.map((tech) => (
              <div class="bg-secondary/50 hover:bg-secondary rounded-lg p-4 text-center transition-all duration-300 h-full flex items-center justify-center hover:shadow-md">
                <span class="font-medium">{tech}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const triggers = document.querySelectorAll<HTMLButtonElement>('[data-tab-trigger]');
  const panels = document.querySelectorAll<HTMLDivElement>('[data-tab-panel]');

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const name = trigger.dataset.tabTrigger;

      triggers.forEach((t) => {
        const active = t === trigger;
        t.classList.toggle('bg-background', active);
        t.classList.toggle('text-primary', active);
        t.classList.toggle('shadow-sm', active);
        t.setAttribute('aria-selected', String(active));
      });

      panels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.dataset.tabPanel !== name);
      });
    });
  });
</script>
