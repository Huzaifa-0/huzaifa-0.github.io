---
interface ExperienceItem {
  title: string;
  company: string;
  location: string;
  period: string;
  achievements: string[];
  skills?: string[];
}

const experienceData: ExperienceItem[] = [
  {
    title: 'Lead Full-Stack Developer',
    company: 'DA STUDIO',
    location: 'Dubai',
    period: 'February 2023 — Present',
    achievements: [
      'Designed high-performance search systems using Meilisearch and Sphinx, improving query response times and content discoverability',
      'Implemented Redis caching and optimized database queries, reducing backend latency and improving overall application performance',
      'Led modernization efforts including framework migrations and backend architecture improvements for legacy systems',
      'Reduced Time to Interactive (TTI) by architecting a code-splitting strategy and leveraging React Server Components for heavy data fetching',
      'Improved Core Web Vitals and SEO performance by eliminating layout shifts, optimizing asset delivery, and reducing render-blocking resources',
      'Managed CI/CD pipelines using GitHub Actions with automated testing, deployment workflows, and AWS infrastructure provisioning',
      'Conducted code reviews, mentored developers, and coordinated backend architecture decisions across multiple product teams',
      'Integrated APM and monitoring solutions for production systems, enabling performance bottleneck detection, error tracking, and infrastructure health monitoring',
    ],
    skills: ['Microservices', 'Monorepo', 'Event-Driven Architecture', 'Vector Search', 'Test Driven Development', 'AI Tools Integration', 'MongoDB Aggregation Optimization', 'CI/CD Pipeline Automation'],
  },
  {
    title: 'Full-Stack Developer',
    company: 'IT FAQ',
    location: 'Dubai',
    period: 'August 2022 — February 2023',
    achievements: [
      'Built and maintained scalable backend services using NestJS and PostgreSQL, delivering Swagger-documented REST APIs',
      'Implemented TanStack Query background refetching to maintain real-time data freshness and a reactive client-side experience',
      'Integrated payment systems including Stripe and PayPal with subscription management and webhook processing',
      'Refactored legacy APIs into a modern modular architecture, improving maintainability and development speed',
      'Participated in CI/CD pipeline implementation using GitHub Actions, integrating automated testing and deployment workflows',
    ],
    skills: ['Redis Caching', 'Next.js (ISR/SSR)', 'Payment Gateway Integration', 'Docker Containerization', 'Modular Software Architecture', 'Legacy System Refactoring'],
  },
  {
    title: 'Full-Stack Developer',
    company: 'HET',
    location: 'Istanbul',
    period: 'March 2021 — April 2022',
    achievements: [
      'Optimized rendering performance by implementing virtualization for large datasets and strategic memoization to minimize reconciliation overhead',
      'Implemented background jobs and cron-based automation for system notifications and maintenance tasks',
      'Architected a modular form system in Vue.js using Composables, improving overall UX consistency',
      'Enhanced data integrity in Vue for complex multi-step form validation and error state management',
      'Optimized database queries, indexing strategies, and memory-efficient data access patterns, improving application performance',
    ],
    skills: ['React.js SPA', 'Vue Composables', 'MySQL Indexing', 'Nginx', 'Reverse Proxy', 'CDN', 'Background Job Processing', 'Frontend Performance Optimization', 'SEO Technical Audit'],
  },
  {
    title: 'Java Backend Developer Intern',
    company: 'Enoca',
    location: 'Ankara/Karabük',
    period: 'June 2019 —  September 2019',
    achievements: [
      'Developed custom Java plugins using Spring Framework integrated into SAP Hybris Commerce platform',
      'Implemented custom business logic and services following SAP Hybris architecture patterns and Spring best practices',
      'Built custom extensions and modules extending Hybris core functionality with Spring dependency injection',
      'Worked with Hybris data models, services layer, and facades to deliver e-commerce functionalities',
      'Collaborated with senior developers on product catalog management and order processing workflows',
      'Participated in code reviews and gained hands-on experience with enterprise-level e-commerce systems',
      'Contributed to improving platform stability through bug fixes and unit testing',
    ],
  },
];
---

<section id="experience" class="section">
  <div class="container">
    <div data-reveal data-reveal-delay="0.1" class="mb-4">
      <h2 class="section-title text-center">Professional Experience</h2>
    </div>

    <div data-reveal data-reveal-delay="0.2" class="mb-6">
      <div class="w-16 h-1 bg-primary mx-auto"></div>
    </div>

    <div data-reveal data-reveal-delay="0.3" class="mb-12">
      <p class="section-subtitle text-center mx-auto">
        My journey in software development and the impact I've made
      </p>
    </div>

    <div class="relative max-w-6xl mx-auto">
      <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-[2px] bg-primary/20 -translate-x-1/2"></div>

      {experienceData.map((experience, index) => {
        const isLeft = index % 2 === 0;
        return (
          <div data-reveal data-reveal-delay={0.4 + index * 0.1}>
            <div class:list={['relative flex items-center mb-12 md:mb-16', isLeft ? 'md:flex-row' : 'md:flex-row-reverse']}>
              <div class:list={['w-full md:w-[calc(50%-2rem)]', isLeft ? 'md:pr-8' : 'md:pl-8']}>
                <div class="bg-secondary/30 backdrop-blur-sm rounded-lg p-6 hover:shadow-lg transition-all duration-300 hover:bg-secondary/40 relative">
                  <div
                    class:list={[
                      'hidden md:block absolute top-8 w-0 h-0 border-t-8 border-b-8 border-transparent',
                      isLeft ? 'right-[-16px] border-l-8 border-l-secondary/30' : 'left-[-16px] border-r-8 border-r-secondary/30',
                    ]}
                  />

                  <div class="flex flex-col gap-2 mb-4">
                    <h3 class="text-xl md:text-2xl font-bold text-foreground">{experience.title}</h3>
                    <div class="flex items-center gap-2 text-lg font-semibold text-primary">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                      <span>{experience.company}</span>
                    </div>
                    <div class="flex flex-wrap gap-3 text-sm text-muted-foreground">
                      <div class="flex items-center gap-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                        <span>{experience.period}</span>
                      </div>
                      <div class="flex items-center gap-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
                        <span>{experience.location}</span>
                      </div>
                    </div>
                  </div>

                  <ul class="space-y-2">
                    {experience.achievements.map((achievement) => (
                      <li class="flex gap-2 text-muted-foreground text-sm">
                        <span class="text-primary mt-1 flex-shrink-0">&bull;</span>
                        <span class="leading-relaxed">{achievement}</span>
                      </li>
                    ))}
                  </ul>

                  {experience.skills && (
                    <div class="flex flex-wrap gap-2 mt-4">
                      {experience.skills.map((skill) => (
                        <span class="text-xs rounded-full px-2.5 py-1 bg-primary/10 text-primary">{skill}</span>
                      ))}
                    </div>
                  )}
                </div>
              </div>

              <div class="hidden md:flex absolute left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-primary border-4 border-background shadow-lg z-10"></div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
